{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "disdown",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "routes": [
    { "pattern": "disdown.timsfun.com", "custom_domain": true }
  ],
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
